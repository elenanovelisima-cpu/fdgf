{
  "manifest_version": 3,
  "name": "autopubli24 - WhatsApp Auto Sender",
  "version": "1.0.0",
  "description": "Envío 100% automático y desatendido de WhatsApp Web con rotación de plantillas y anti-bloqueo para autopubli24.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "autopubli24 Auto Sender"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "alarms"
  ],
  "host_permissions": [
    "*://web.whatsapp.com/*",
    "http://*/*",
    "https://*/*"
  ],
  "content_scripts": [
    {
      "matches": ["*://web.whatsapp.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://*.run.app/*", "http://localhost/*", "http://127.0.0.1/*"],
      "js": ["content_app.js"],
      "run_at": "document_idle"
    }
  ]
}
